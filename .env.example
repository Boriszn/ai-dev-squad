# -----------------------------------------------------------------------------
# AI Dev Squad environment configuration
# -----------------------------------------------------------------------------
#
# This file contains example environment values for local development.
# Copy it to `.env` and adjust the values for your machine and workflow.
#
# Main provider options:
# - codex : use Codex CLI for online/local coding execution
# - local : use a local model provider through Ollama
#
# Notes:
# - Codex requires the `codex` CLI to be installed and logged in
# - Local provider expects Ollama to be running on http://localhost:11434
# - The current local provider is generation-only in the first version
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Application settings
# -----------------------------------------------------------------------------

# Environment name for local development.
APP_ENV=local

# Human-readable application name.
APP_NAME=AI Dev Squad

# Default provider used by the model router.
# Supported values:
# - codex
# - local
DEFAULT_MODEL_PROVIDER=codex

# -----------------------------------------------------------------------------
# Codex settings
# -----------------------------------------------------------------------------

# Codex CLI command name.
# The default assumes `codex` is available on PATH.
CODEX_CLI_COMMAND=codex

# -----------------------------------------------------------------------------
# Local model settings
# -----------------------------------------------------------------------------

# Local model name used by the local provider.
# Default choice for this project on Apple M2 Pro 16 GB:
# qwen2.5-coder:7b
LOCAL_MODEL_NAME=qwen2.5-coder:7b

# Optional base URL for Ollama.
# The local provider uses this endpoint to call the local model runtime.
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Test settings
# -----------------------------------------------------------------------------

# Default test command used by the Tester Agent.
DEFAULT_TEST_COMMAND=pytest -q

# -----------------------------------------------------------------------------
# Tool execution mode
# -----------------------------------------------------------------------------

# Mock mode is useful for early workflow testing.
# true  = do not run real external tools
# false = run real provider/tool logic
ENABLE_MOCK_TOOLS=false

# -----------------------------------------------------------------------------
# LangGraph Studio / LangSmith settings
# -----------------------------------------------------------------------------
#
# These settings are only needed if you want to use LangGraph Studio locally.
# The app settings loader ignores unrelated extra env vars safely.
# -----------------------------------------------------------------------------

# Personal Access Token for LangSmith / LangGraph Studio.
LANGSMITH_API_KEY=your_langsmith_pat_here

# Enable or disable LangSmith tracing.
# true  = tracing enabled
# false = tracing disabled
LANGSMITH_TRACING=false