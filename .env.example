# -----------------------------------------------------------------------------
# AI Dev Squad environment example
# -----------------------------------------------------------------------------

# Application mode
APP_ENV=local
APP_NAME=AI Dev Squad

# Default provider used by the model router.
# Supported now:
# - codex
# - local
DEFAULT_MODEL_PROVIDER=codex

# Codex CLI command.
# The default assumes the codex executable is on PATH.
CODEX_CLI_COMMAND=codex

# Local model placeholder.
# Example future value for Ollama:
# LOCAL_MODEL_NAME=qwen2.5-coder:7b
LOCAL_MODEL_NAME=qwen2.5-coder:7b

# Optional test command.
# Use pytest by default.
DEFAULT_TEST_COMMAND=pytest -q

# Mock mode can be used for safe local graph testing before real integration.
ENABLE_MOCK_TOOLS=true
